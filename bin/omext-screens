#!/usr/bin/env python3
"""Where the screens are, next to each other.

Usage:
  omext-screens list             JSON: the connected screens (name, description, and in
                                 layout pixels: x, y, w, h; scale), and whether their
                                 arrangement is one kept here ("kept")
  omext-screens set <JSON>       put them where the list says ([{"description": ..,
                                 "x": .., "y": ..}, ...], in layout pixels): now, and
                                 kept for this set of screens
  omext-screens apply            the screens changed, or Hyprland read its config again:
                                 the arrangement kept for the set connected, if there is one
  omext-screens reset            forget the arrangement kept for the screens connected
                                 (your own Hyprland config places them again)
  omext-screens mode             JSON: what the screens show now ("mode": pc, duplicate,
                                 extend, second; or single, with one screen connected)
  omext-screens mode <pc|duplicate|extend|second>
                                 the laptop's screen only, the same on both, one desktop
                                 over both, or the other screen only

An arrangement is kept per set of screens (the laptop with the big screen at
work is one, the laptop with another screen at home another), in
~/.config/omext/screens.json. It is given to Hyprland as monitor rules, in a
file of its own that the addon's hypr/screens.lua loads after your own
monitors.lua; each rule keeps the screen's mode, scale and rotation as they
are. Screens may not overlap, and are moved so the top left one is at 0, 0.

The modes are a laptop's with another screen connected. Duplicate, extend and
second-screen-only are Omarchy's own switches (omarchy hyprland monitor
internal ...), so its keys and its recovery when the screen is unplugged
follow; the laptop's screen only is a rule of this tool's (the other screens
off, by their description, so another screen on the same plug still comes on).
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

CORE = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "omarchy" / "plugins" / "omext.core"
sys.path.insert(0, str(CORE))
try:
    import omext_settings as settings
except ImportError:
    sys.exit("omext-screens: needs omext core (https://github.com/omarchy-extended/core)")

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "omext" / "screens.json"
STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "omext" / "arrange"
RULES = STATE / "screens.lua"
ONLY = STATE / "mode.lua"   # the laptop's screen only: the other screens off
TOGGLES = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "omarchy" / "toggles" / "hypr"
MODES = ("pc", "duplicate", "extend", "second")


def die(msg):
    print(f"omext-screens: {msg}", file=sys.stderr)
    sys.exit(1)


def hypr(what):
    return json.loads(subprocess.run(["hyprctl", what, "-j"], capture_output=True, text=True, check=True).stdout)


def name_of(m):
    return m.get("description") or m["name"]


def key_of(monitors):
    return "|".join(sorted(name_of(m) for m in monitors))


def logical(m):
    w, h = m["width"] / m["scale"], m["height"] / m["scale"]
    return (round(h), round(w)) if m.get("transform", 0) % 2 else (round(w), round(h))


def lua(text):
    return '"' + str(text).replace("\\", "\\\\").replace('"', '\\"') + '"'


def rules(monitors, places):
    """The monitor rules that put the screens at their places, each with its
    mode, scale and rotation as they are now."""
    out = []
    for m in monitors:
        at = places.get(name_of(m))
        if not at:
            continue
        output = "desc:" + m["description"] if m.get("description") else m["name"]
        mode = f"{m['width']}x{m['height']}@{m['refreshRate']:.3f}"
        extra = f", transform = {m['transform']}" if m.get("transform") else ""
        out.append(f"hl.monitor({{ output = {lua(output)}, mode = {lua(mode)}, position = {lua(f'{at[0]}x{at[1]}')}, "
                   f"scale = {m['scale']:g}{extra} }})")
    return out


def write_rules(lines):
    STATE.mkdir(parents=True, exist_ok=True)
    had = RULES.exists() and "hl.monitor" in RULES.read_text()
    RULES.write_text("-- Written by omext-screens (where the screens are); see omext-screens --help.\n" + "\n".join(lines) + "\n")
    return had


def cmd_list():
    monitors = hypr("monitors")
    kept = (settings.read(CONFIG, {}) or {}).get(key_of(monitors))
    out = []
    for m in monitors:
        w, h = logical(m)
        out.append({"name": m["name"], "description": name_of(m), "x": m["x"], "y": m["y"], "w": w, "h": h,
                    "scale": m["scale"], "focused": bool(m.get("focused"))})
    print(json.dumps({"screens": out, "kept": bool(kept), "mode": mode_now()}, ensure_ascii=False))


def cmd_set(args):
    try:
        want = {str(s["description"]): (int(round(s["x"])), int(round(s["y"]))) for s in json.loads(args[0])}
    except (IndexError, ValueError, KeyError, TypeError):
        die('set needs the screens as JSON: [{"description": "..", "x": 0, "y": 0}, ...]')
    monitors = hypr("monitors")
    missing = [name_of(m) for m in monitors if name_of(m) not in want]
    if missing:
        die("no place given for " + ", ".join(missing))
    boxes = []
    for m in monitors:
        w, h = logical(m)
        x, y = want[name_of(m)]
        boxes.append((name_of(m), x, y, w, h))
    for i, a in enumerate(boxes):
        for b in boxes[i + 1:]:
            if a[1] < b[1] + b[3] and b[1] < a[1] + a[3] and a[2] < b[2] + b[4] and b[2] < a[2] + a[4]:
                die(f"{a[0]} and {b[0]} would overlap")
    left, top = min(b[1] for b in boxes), min(b[2] for b in boxes)
    places = {b[0]: [b[1] - left, b[2] - top] for b in boxes}
    data = settings.read(CONFIG, {}) or {}
    data[key_of(monitors)] = places
    settings.write(CONFIG, data)
    lines = rules(monitors, places)
    write_rules(lines)
    subprocess.run(["hyprctl", "eval", " ".join(lines)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_apply():
    # The other screens are off by this tool, and the laptop's is not there to
    # show anything (lid closed, or off): they come back on.
    inside, _ = every_screen()
    if (not inside or inside.get("disabled")) and only_off():
        reload()
    monitors = hypr("monitors")
    places = (settings.read(CONFIG, {}) or {}).get(key_of(monitors))
    if places:
        lines = rules(monitors, places)
        write_rules(lines)
        subprocess.run(["hyprctl", "eval", " ".join(lines)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif write_rules([]):
        # Rules from another set of screens were in force: your own config's again.
        subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def every_screen():
    """The screens connected, the ones turned off too: the laptop's own, the others."""
    found = [m for m in json.loads(subprocess.run(["hyprctl", "monitors", "all", "-j"], capture_output=True, text=True,
                                                  check=True).stdout) if m["name"] != "FALLBACK"]
    own = os.environ.get("OMEXT_INTERNAL")  # (a laptop screen under another name)
    inside = next((m for m in found if (m["name"] == own if own else re.match(r"(eDP|LVDS|DSI)-", m["name"]))), None)
    return inside, [m for m in found if m is not inside]


def mode_now():
    inside, others = every_screen()
    if not inside or not others:
        return "single"
    if inside.get("disabled"):
        return "second"
    if all(m.get("disabled") for m in others):
        return "pc"
    if any(m.get("mirrorOf") not in (None, "", "none") for m in [inside] + others):
        return "duplicate"
    return "extend"


def reload():
    subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(1.2)  # the screens come and go: what is asked next sees them as they are


def omarchy(*args):
    subprocess.run(list(args), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def only_off():
    """The other screens back on, if this tool had them off."""
    if ONLY.exists() and "hl.monitor" in ONLY.read_text():
        ONLY.write_text("-- Written by omext-screens (the laptop's screen only); see omext-screens --help.\n")
        return True
    return False


def cmd_mode(args):
    if not args:
        inside, others = every_screen()
        print(json.dumps({"mode": mode_now(), "internal": inside["name"] if inside else None,
                          "others": [m["name"] for m in others]}))
        return
    want = args[0]
    if want not in MODES:
        die("mode is one of " + ", ".join(MODES))
    inside, others = every_screen()
    if not inside or not others:
        die("a laptop's screen and another one are needed for that")
    if not shutil.which("omarchy-hyprland-monitor-internal"):
        die("needs Omarchy's own screen switches (omarchy-hyprland-monitor-internal)")
    if want == mode_now():
        return
    mirror, off = TOGGLES / "internal-monitor-mirror.lua", TOGGLES / "internal-monitor-disable.lua"
    changed = only_off() if want != "pc" else False
    if mirror.exists() and want != "duplicate":
        omarchy("omarchy-hyprland-monitor-internal-mirror", "off")
        changed = True
    if off.exists() and want != "second":
        omarchy("omarchy-hyprland-monitor-internal", "on")
        changed = True
    if changed:
        reload()
    if want == "duplicate":
        omarchy("omarchy-hyprland-monitor-internal-mirror", "on")
    elif want == "second":
        omarchy("omarchy-hyprland-monitor-internal", "off")
    elif want == "pc":
        STATE.mkdir(parents=True, exist_ok=True)
        lines = ["hl.monitor({ output = " + lua("desc:" + m["description"] if m.get("description") else m["name"]) +
                 ", disabled = true })" for m in others]
        ONLY.write_text("-- Written by omext-screens (the laptop's screen only); see omext-screens --help.\n" + "\n".join(lines) + "\n")
        reload()


def cmd_reset():
    monitors = hypr("monitors")
    data = settings.read(CONFIG, {}) or {}
    if data.pop(key_of(monitors), None) is not None:
        settings.write(CONFIG, data)
    write_rules([])
    subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = args[0], args[1:]
    if cmd == "list":
        cmd_list()
    elif cmd == "set":
        cmd_set(rest)
    elif cmd == "apply":
        cmd_apply()
    elif cmd == "reset":
        cmd_reset()
    elif cmd == "mode":
        cmd_mode(rest)
    else:
        die(f"unknown command {cmd}")


if __name__ == "__main__":
    main()
