#!/usr/bin/env python3
"""Where the screens are, next to each other.

Usage:
  omext-screens list             JSON: the connected screens (name, description, and in
                                 layout pixels: x, y, w, h; scale), and whether their
                                 arrangement is one kept here ("kept")
  omext-screens set <JSON>       put them where the list says ([{"description": ..,
                                 "x": .., "y": ..}, ...], in layout pixels): now, and
                                 kept for this set of screens
  omext-screens apply            the screens changed, or Hyprland read its config again:
                                 the arrangement kept for the set connected, if there is one
  omext-screens reset            forget the arrangement kept for the screens connected
                                 (your own Hyprland config places them again)

An arrangement is kept per set of screens (the laptop with the big screen at
work is one, the laptop with another screen at home another), in
~/.config/omext/screens.json. It is given to Hyprland as monitor rules, in a
file of its own that the addon's hypr/screens.lua loads after your own
monitors.lua; each rule keeps the screen's mode, scale and rotation as they
are. Screens may not overlap, and are moved so the top left one is at 0, 0.
"""
import json
import os
import subprocess
import sys
from pathlib import Path

CORE = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "omarchy" / "plugins" / "omext.core"
sys.path.insert(0, str(CORE))
try:
    import omext_settings as settings
except ImportError:
    sys.exit("omext-screens: needs omext core (https://github.com/omarchy-extended/core)")

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "omext" / "screens.json"
STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "omext" / "arrange"
RULES = STATE / "screens.lua"


def die(msg):
    print(f"omext-screens: {msg}", file=sys.stderr)
    sys.exit(1)


def hypr(what):
    return json.loads(subprocess.run(["hyprctl", what, "-j"], capture_output=True, text=True, check=True).stdout)


def name_of(m):
    return m.get("description") or m["name"]


def key_of(monitors):
    return "|".join(sorted(name_of(m) for m in monitors))


def logical(m):
    w, h = m["width"] / m["scale"], m["height"] / m["scale"]
    return (round(h), round(w)) if m.get("transform", 0) % 2 else (round(w), round(h))


def lua(text):
    return '"' + str(text).replace("\\", "\\\\").replace('"', '\\"') + '"'


def rules(monitors, places):
    """The monitor rules that put the screens at their places, each with its
    mode, scale and rotation as they are now."""
    out = []
    for m in monitors:
        at = places.get(name_of(m))
        if not at:
            continue
        output = "desc:" + m["description"] if m.get("description") else m["name"]
        mode = f"{m['width']}x{m['height']}@{m['refreshRate']:.3f}"
        extra = f", transform = {m['transform']}" if m.get("transform") else ""
        out.append(f"hl.monitor({{ output = {lua(output)}, mode = {lua(mode)}, position = {lua(f'{at[0]}x{at[1]}')}, "
                   f"scale = {m['scale']:g}{extra} }})")
    return out


def write_rules(lines):
    STATE.mkdir(parents=True, exist_ok=True)
    had = RULES.exists() and "hl.monitor" in RULES.read_text()
    RULES.write_text("-- Written by omext-screens (where the screens are); see omext-screens --help.\n" + "\n".join(lines) + "\n")
    return had


def cmd_list():
    monitors = hypr("monitors")
    kept = (settings.read(CONFIG, {}) or {}).get(key_of(monitors))
    out = []
    for m in monitors:
        w, h = logical(m)
        out.append({"name": m["name"], "description": name_of(m), "x": m["x"], "y": m["y"], "w": w, "h": h,
                    "scale": m["scale"], "focused": bool(m.get("focused"))})
    print(json.dumps({"screens": out, "kept": bool(kept)}, ensure_ascii=False))


def cmd_set(args):
    try:
        want = {str(s["description"]): (int(round(s["x"])), int(round(s["y"]))) for s in json.loads(args[0])}
    except (IndexError, ValueError, KeyError, TypeError):
        die('set needs the screens as JSON: [{"description": "..", "x": 0, "y": 0}, ...]')
    monitors = hypr("monitors")
    missing = [name_of(m) for m in monitors if name_of(m) not in want]
    if missing:
        die("no place given for " + ", ".join(missing))
    boxes = []
    for m in monitors:
        w, h = logical(m)
        x, y = want[name_of(m)]
        boxes.append((name_of(m), x, y, w, h))
    for i, a in enumerate(boxes):
        for b in boxes[i + 1:]:
            if a[1] < b[1] + b[3] and b[1] < a[1] + a[3] and a[2] < b[2] + b[4] and b[2] < a[2] + a[4]:
                die(f"{a[0]} and {b[0]} would overlap")
    left, top = min(b[1] for b in boxes), min(b[2] for b in boxes)
    places = {b[0]: [b[1] - left, b[2] - top] for b in boxes}
    data = settings.read(CONFIG, {}) or {}
    data[key_of(monitors)] = places
    settings.write(CONFIG, data)
    lines = rules(monitors, places)
    write_rules(lines)
    subprocess.run(["hyprctl", "eval", " ".join(lines)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_apply():
    monitors = hypr("monitors")
    places = (settings.read(CONFIG, {}) or {}).get(key_of(monitors))
    if places:
        lines = rules(monitors, places)
        write_rules(lines)
        subprocess.run(["hyprctl", "eval", " ".join(lines)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif write_rules([]):
        # Rules from another set of screens were in force: your own config's again.
        subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_reset():
    monitors = hypr("monitors")
    data = settings.read(CONFIG, {}) or {}
    if data.pop(key_of(monitors), None) is not None:
        settings.write(CONFIG, data)
    write_rules([])
    subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = args[0], args[1:]
    if cmd == "list":
        cmd_list()
    elif cmd == "set":
        cmd_set(rest)
    elif cmd == "apply":
        cmd_apply()
    elif cmd == "reset":
        cmd_reset()
    else:
        die(f"unknown command {cmd}")


if __name__ == "__main__":
    main()
